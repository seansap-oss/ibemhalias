# =====================================================================
# IBEMHAL IAS LMS — Environment Template
#
# Supabase Project Ref : nhjhnevxyynllomfmyxp
# Supabase Dashboard   : https://supabase.com/dashboard/project/nhjhnevxyynllomfmyxp
# Production URL       : https://ibemhal-ias-lms.vercel.app
#
# Copy to `.env.local` and fill in the secrets. Never commit the filled file.
# =====================================================================

# ---------------------------------------------------------------------
# SUPABASE  (required for auth, /admin protection and data persistence)
# Keys: Dashboard → Project Settings → API
# ---------------------------------------------------------------------

# Project URL — bound to project ref `nhjhnevxyynllomfmyxp`
NEXT_PUBLIC_SUPABASE_URL=https://nhjhnevxyynllomfmyxp.supabase.co

# "anon / public" key — safe to expose to the browser, gated by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY. Bypasses every RLS policy.
# Never prefix with NEXT_PUBLIC_. Never ship to the client or the APK.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# CAPACITOR / NATIVE APK
# Inside the Android app there is no local server, so /api/* calls are
# proxied to this deployed origin. Leave blank for web-only builds.
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://ibemhal-ias-lms.vercel.app

# ---------------------------------------------------------------------
# MUX VIDEO  (HLS streaming + auto-captions)
# ---------------------------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ---------------------------------------------------------------------
# AI FAILOVER CHAIN — configure at least one.
# The router walks Tier 1 → Tier 5 and falls back to the built-in
# deterministic engine (Tier 6) so requests never hard-fail.
# ---------------------------------------------------------------------

# Tier 1 — Anthropic Claude 3.5 Sonnet (best essay / answer grading)
ANTHROPIC_API_KEY=

# Tier 2 — OpenAI GPT-4o (fast structured JSON, quiz generation)
OPENAI_API_KEY=

# Tier 3 — Google Gemini 1.5 Pro (huge context for PDFs & transcripts)
GOOGLE_API_KEY=

# Tier 4 — DeepSeek V3 (lowest cost capable reasoning)
DEEPSEEK_API_KEY=

# Tier 5 — Groq Llama 3.3 70B (ultra-fast emergency fallback)
GROQ_API_KEY=

# Tier 6 — Ibemhal Deterministic Engine (built in, no key required)

# ---------------------------------------------------------------------
# ANDROID RELEASE SIGNING (CI alternative to android/keystore.properties)
# See SIGNING_INSTRUCTIONS.md
# ---------------------------------------------------------------------
# ANDROID_KEYSTORE_PATH=upload-keystore.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=ibemhal-upload
# ANDROID_KEY_PASSWORD=

WHATSAPP_ACCESS_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_GRAPH_VERSION=v23.0

WHATSAPP_TEMPLATE_CLASS_REMINDER=ibemhal_class_reminder

WHATSAPP_TEMPLATE_PURCHASE=ibemhal_purchase_confirmation

WHATSAPP_TEMPLATE_RECORDING=ibemhal_recording_ready
# ---------------------------------------------------------------------
# LIVE NOW / LIVEKIT PRODUCTION
# Local development is supplied by START-LIVE-NOW.ps1.
# Vercel production requires a real public LiveKit deployment (normally
# LiveKit Cloud) and MUST NOT use ws://127.0.0.1:7880.
# ---------------------------------------------------------------------
LIVE_NOW_LICENSE_MODE=owner
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# VERCEL-ONLY PRESENTATION MODE
# Set to true only for a client demonstration. The Teacher Studio will run
# camera/microphone/screen/PDF locally in the browser without connecting to
# any external media service. Set false/remove for real multi-user Live Now.
NEXT_PUBLIC_LIVE_NOW_DEMO_MODE=false