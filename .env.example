# Ibemhal IAS V5.4 — Live Now Pro Studio
# Never commit real secrets.

# LiveKit OSS / self-hosted
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Live Now licensing
# This Ibemhal instance is the product owner's own installation.
LIVE_NOW_LICENSE_MODE=owner

# External customer installations should use remote mode instead:
# LIVE_NOW_LICENSE_MODE=remote
# LIVE_NOW_LICENSE_SERVER_URL=https://api.your-live-now-domain.com
# LIVE_NOW_LICENSE_KEY=
# LIVE_NOW_CUSTOMER_ID=

# Existing 100ms variables may remain in source/environment for future fallback,
# but 100ms is not exposed in the current Live Now UI.
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
